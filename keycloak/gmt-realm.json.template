      "id": "34b2f7ca-d884-490a-b48e-57078d51c4cc",
      "name": "membership",
      "description": "List of organizations and field activities the user is a member of",
    "protocol" : "openid-connect",
    "attributes" : {
      "include.in.token.scope" : "true",
        "display.on.consent.screen": "true"
    },
    "protocolMappers" : [ {
          "id": "8632f10b-fb1e-42a3-88e3-86538d3880f3",
          "name": "membership",
      "protocol" : "openid-connect",
          "protocolMapper": "oidc-script-based-protocol-mapper",
      "consentRequired" : false,
      "config" : {
        "userinfo.token.claim" : "true",
        "multivalued" : "true",
        "id.token.claim" : "true",
        "access.token.claim" : "true",
            "claim.name": "membership",
            "jsonType.label": "JSON",
            "script": "/**\n * Available variables: \n * user - the current user\n * realm - the current realm\n * token - the current token\n * userSession - the current userSession\n * keycloakSession - the current userSession\n */\nvar ArrayList = Java.type('java.util.ArrayList');\n \nvar access_token = keycloakSession.tokens().encode(token);\nvar query = '{me{' +\n    'organizations{id name}' +\n    'fieldActivities{id code name}' +\n    '}}';\n\nvar result = httpGet(\"\" + \"?query=\" + encodeURIComponent(query)).data;\n\nvar user_organizations = new ArrayList();\nvar user_field_activities = new ArrayList();\nvar user_tracking_rounds = new ArrayList();\nJSON.parse(result).data.me.organizations.map(function(org){\n    user_organizations.add(org);\n});\nJSON.parse(result).data.me.fieldActivities.map(function(org){\n    user_field_activities.add(org);\n});\n\ntoken.setOtherClaims(\"membership\", {\n    organizations: user_organizations,\n    field_activities: user_field_activities,\n    tracking_rounds: user_tracking_rounds\n})\n\n\n\n/*************\nUTILITY FUNCTIONS\n*************/\n\nfunction httpGet(theUrl){\n    var con = new java.net.URL(theUrl).openConnection();\n    con.requestMethod = \"GET\";\n    con.setRequestProperty(\"Authorization\", \"Bearer \" + access_token);\n\n    return asResponse(con);\n}\n\nfunction httpPost(theUrl, data, contentType){\n    contentType = contentType || \"application/json\";\n    var con = new java.net.URL(theUrl).openConnection();\n\n    con.requestMethod = \"POST\";\n    con.setRequestProperty(\"Content-Type\", contentType);\n\n    // Send post request\n    con.doOutput=true;\n    write(con.outputStream, data);\n\n    return asResponse(con);\n}\n\nfunction asResponse(con){\n    var d = read(con.inputStream);\n\n    return {data : d, statusCode : con.responseCode};\n}\n\nfunction write(outputStream, data){\n    var wr = new java.io.DataOutputStream(outputStream);\n    wr.writeBytes(data);\n    wr.flush();\n    wr.close();\n}\n\nfunction read(inputStream){\n    var inReader = new java.io.BufferedReader(new java.io.InputStreamReader(inputStream));\n    var inputLine;\n    var response = new java.lang.StringBuffer();\n\n    while ((inputLine = inReader.readLine()) !== null) {\n           response.append(inputLine);\n    }\n    inReader.close();\n    return response.toString();\n}"
