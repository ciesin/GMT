export COMPOSE_FILE=docker-compose.yml#docker-compose.db.yml#docker-compose.ports-published.yml#docker-compose.db-ports-published.yml#docker-compose.local.yml
export COMPOSE_PROJECT_NAME=gmt

export DOCKER_IMAGE_TAG=latest-dev

# General params
export ENV_NAME=dev
export RUN_NODEJS_OUTSIDE_OF_DOCKER=false
export GA_TRACKING_CODE=

# Note!  If you want to run nodejs outside of docker, then in your CUSTOM USER env file not in git
# put these 2 properties
# export RUN_IMPORTER_OUTSIDE_OF_DOCKER=true
# export EXTERNAL_IMPORTER_HOSTNAME=localhost


export CONFIG_FILE_NAME=${ENV_NAME}.local
export APP_VERSION=latest-dev

# Importer Params
export DOCKER_IMPORTER_HOSTNAME=importer


# DB Params
export DOCKER_DB_HOSTNAME=gmt_db
export DB_ADMIN_USER=postgres
export POSTGRES_DB=postgres
export POSTGRES_USER=${DB_ADMIN_USER}

# Docker-specific params
export DOCKER_IMAGES_PREFIX=gmt_
export DOCKER_NETWORK_MODE=ingress
export DB_PUBLISHED_PORT=25432
export GMT_PWA_INTERNAL_PORT=4200
export GMT_PWA_PUBLISHED_PORT=4242
export NODEJS_INTERNAL_PORT=3000
export NODEJS_PUBLISHED_PORT=4243
export GEOSERVER_INTERNAL_PORT=8080
export GEOSERVER_PUBLISHED_PORT=4244
export IMPORTER_INTERNAL_PORT=5000
export IMPORTER_PUBLISHED_PORT=5042
export KEYCLOAK_INTERNAL_PORT=4249
export KEYCLOAK_PUBLISHED_PORT=4248
export QUEUES_INTERNAL_PORT=5000
export QUEUES_PUBLISHED_PORT=4225
#export NETWORK_NAME=gmt-${ENV_NAME}-net
# Useful only for db migrations
export DOCKER_NETWORK_NAME=gmt_net
export DOCKER_NETWORK_IS_EXTERNAL=false
# ------------- Angular config -----------------------
#export ANGULAR_START_COMMAND="tail -f /dev/null"
export ANGULAR_START_COMMAND="ng serve --host 0.0.0.0 --disable-host-check --hmr"
export CONFIG_TEMPLATE_FILE_OVERRIDE=/usr/src/app/src/assets/config.json.template
export MANIFEST_TEMPLATE_FILE_OVERRIDE=/usr/src/app/src/assets/manifest.webmanifest.template
export CONFIG_FILE_DEST_OVERRIDE=/usr/src/app/src/assets/config.json
export MANIFEST_FILE_DEST_OVERRIDE=/usr/src/app/src/manifest.webmanifest
# export CONFIG_TEMPLATE_FILE_OVERRIDE=/usr/share/nginx/html/assets/config.json.template
# export MANIFEST_TEMPLATE_FILE_OVERRIDE=/usr/share/nginx/html/assets/manifest.webmanifest.template
# export CONFIG_FILE_DEST_OVERRIDE=/usr/share/nginx/html/assets/config.json
# export MANIFEST_FILE_DEST_OVERRIDE=/usr/share/nginx/html/manifest.webmanifest
# export ANGULAR_SERVE_PATH=/usr/share/nginx/html/
export ANGULAR_SERVE_PATH=/usr/src/app/src/
export ANGULAR_DO_SUBSTITUTE_CONFIG=true
export DISABLE_SYNC=false
export DEVELOPER_MODE=true
export API_URL=http://localhost:4243
export PWA_URL=http://localhost:4242
export GEOSERVER_URL=http://localhost:4244/geoserver/gmt/wms
export IS_PROD=false
export ENV_COLOR=#00FF00
export GMT_DOC_ROOT=http://localhost:4243/help

# Postgres
export DB_HOST=${DOCKER_DB_HOSTNAME}
export DB_USER=postgres
export DB_NAME=gmt
export DB_PORT=5432
export PGPASS_PATH=/tmp/db.pgpass

# ------------- Geoserver config -----------------------
export VOLUMES_ROOT_GEOSERVER_OVERRIDE=.
export GEOSERVER_ADMIN_USER=gmt_admin
export GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
export GEOSERVER_DB_SCHEMA=public
export ENABLE_JSONP=true
export MAX_FILTER_RULES=20
export OPTIMIZE_LINE_WIDTH=false

# ------------- DB MANAGER config -----------------------
export WAIT_FOR_DATABASE=true
export WAIT_FOR_DATABASE_TIMEOUT=60

# DB config
export DB_ADMIN_USER_FOR_CREATE=postgres
export DB_ADMIN_USER=postgres
export POSTGRES_DB=postgres
export DB_USER_FOR_CREATE=${DB_USER}

# Keycloak
# export KEYCLOAK_LOGLEVEL=DEBUG
export KEYCLOAK_HOST=localhost
export KEYCLOAK_DOMAIN=${KEYCLOAK_HOST}
export SECRETS_ROOT=/run/secrets
export GMT_ADMIN_USER=gmt_admin
export GMT_EDITOR_USER=editor
export GMT_READER_USER=reader
export GMT_USERS_ADMIN=users_admin
export KEYCLOAK_GMT_REALM_USER=gmt
export KEYCLOAK_GMT_REALM_NAME=gmt
export KEYCLOAK_IMPORT=/tmp/gmt-realm.json
export KEYCLOAK_USER=admin
export KEYCLOAK_AUTH_URL_PREFIX=auth
export KEYCLOAK_INTERNAL_HOST=keycloak:${KEYCLOAK_INTERNAL_PORT}

export KEYCLOAK_EXTERNAL_HOST=${KEYCLOAK_DOMAIN}:${KEYCLOAK_PUBLISHED_PORT}
# Used when building external URLs (set https when Azure)
export KEYCLOAK_INSTANCE_EXTERNAL_PROTOCOL=http
export KEYCLOAK_INSTANCE_INTERNAL_PROTOCOL=http
# Deal with Internal / External Hosts & URLS
export KEYCLOAK_INSTANCE_ROOT_URL=${KEYCLOAK_INSTANCE_EXTERNAL_PROTOCOL}://${KEYCLOAK_INTERNAL_HOST}
export KEYCLOAK_EXTERNAL_ROOT_URL=${KEYCLOAK_DOMAIN}:${KEYCLOAK_PUBLISHED_PORT}
export KEYCLOAK_INTERNAL_BASE_URL=${KEYCLOAK_INSTANCE_INTERNAL_PROTOCOL}://${KEYCLOAK_INTERNAL_HOST}/${KEYCLOAK_AUTH_URL_PREFIX}
export KEYCLOAK_EXTERNAL_BASE_URL=${KEYCLOAK_INSTANCE_EXTERNAL_PROTOCOL}://${KEYCLOAK_EXTERNAL_HOST}/${KEYCLOAK_AUTH_URL_PREFIX}
export KEYCLOAK_FRONTEND_URL=${KEYCLOAK_EXTERNAL_BASE_URL}

export KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=300
export SMTP_REPLY_TO_DISPLAY_NAME=
export SMTP_STARTTLS=
export SMTP_AUTH=
export SMTP_ENVELOPE_FROM=
export SMTP_SSL=
export SMTP_PORT=1025
export SMTP_HOST=mailhog
export SMTP_REPLY_TO=
export SMTP_FROM=gmt@novel-t.ch
export SMTP_FROM_DISPLAY_NAME=GMT
export SMTP_USER=
export SMTP_ADMIN=eg@novel-t.ch

export KEYCLOAK_PROXY_ADDRESS_FORWARDING=true
export KEYCLOAK_WEB_CLIENT_NAME=dashboard
export KEYCLOAK_START_ON_CUSTOM_PORT_COMMAND=-Djboss.http.port=${KEYCLOAK_INTERNAL_PORT}

export KEYCLOAK_JVM_INITIAL_MEMORY="512M"
export KEYCLOAK_JVM_MAXIMUM_MEMORY="1G"

export PROXY_ADDRESS_FORWARDING=true
export CLIENT_DASHBOARD_REDIRECT_URIS=http://localhost*
export CLIENT_DASHBOARD_WEB_ORIGINS=*
# user in nodejs used for users administration
export KEYCLOAK_NODEJS_ADMIN_USERNAME=gmt_admin

# parameter names that keycloak recognizes
export DB_ADDR=db:${DB_PORT}
# name collision export DB_USER=${DB_ADMIN_USER}
export DB_VENDOR=postgres

export DB_KEYCLOAK_DATABASE_NAME=keycloak
export DB_DATABASE=${DB_KEYCLOAK_DATABASE_NAME}
export DB_KEYCLOAK_DATABASE_USER_FOR_CREATE=${DB_USER}
export KEYCLOAK_PWA_SCOPE=openid

# queues and redis settings
export REDIS_INTERNAL_PORT=6379
export REDIS_PUBLISHED_PORT=6379
export REDIS_HOSTNAME=redis
export ALLOW_EMPTY_PASSWORD=yes

# ================== Coverage config ========================
# Coverages in each category converted to a % of the
# weight / total weight in that category for each square

# Category strategy
export COVERAGE_WEIGHT_STRATEGY_FIXED_POST=0.5
export COVERAGE_WEIGHT_STRATEGY_OUTREACH=0.5

# Category frequency
export COVERAGE_WEIGHT_FREQUENCY_UNKNOWN=30
export COVERAGE_WEIGHT_FREQUENCY_ONCE_PER_MONTH=1
export COVERAGE_WEIGHT_FREQUENCY_TWICE_PER_MONTH=2
export COVERAGE_WEIGHT_FREQUENCY_THREE_PER_MONTH=3
export COVERAGE_WEIGHT_FREQUENCY_ONCE_PER_WEEK=4
export COVERAGE_WEIGHT_FREQUENCY_TWICE_PER_WEEK=8
export COVERAGE_WEIGHT_FREQUENCY_THREE_PER_WEEK=12
export COVERAGE_WEIGHT_FREQUENCY_FOUR_PER_WEEK=16
export COVERAGE_WEIGHT_FREQUENCY_FIVE_PER_WEEK=20
export COVERAGE_WEIGHT_FREQUENCY_SIX_PER_WEEK=24
export COVERAGE_WEIGHT_FREQUENCY_DAILY=30
export COVERAGE_WEIGHT_FREQUENCY_OTHER=15
export COVERAGE_WEIGHT_FREQUENCY_WEEKLY=10

# Category in boundary
export COVERAGE_WEIGHT_BOUNDARY_INSIDE=0.5
export COVERAGE_WEIGHT_BOUNDARY_OUTSIDE=0.5

# Converting distance to weight

# These are breakpoints of (weight, distance in meters)
# any distance between a breakpoint will be linearly interpolated
# format is weight_1,distance_1;weight_2,distance_2
# Example 0,100;500,90;1000,50;2000,10;3000,0
# Any distance greater than the max distance in this config is considered not reachable
export COVERAGE_WEIGHT_DISTANCE_BREAKPOINTS="0,100;500,90;1000,50;1950,10;2000,5"

# How much of a raster square must be covered by a HF to be considered
# Anything lower then this threshold is pruned
# Note that this will never prune the last matching in boundary health facility, at this point, it will stop
export COVERAGE_WEIGHT_MIN_PERCENTAGE=0.20

# If a health facility is covering less than this % of a settlements population,
# and is also less than the pop value, then
# it is not counted
# Note that HF inside the boundary are never pruned
export COVERAGE_WEIGHT_MIN_SETT_PERCENTAGE=0.15
export COVERAGE_WEIGHT_MIN_SETT_POP=10000

# ================== Coverage config end =======================

# ================== Queues session config =====================
export ADMIN_SESSION_HTTP_ONLY=1
export ADMIN_SESSION_SIGNED=0
#export ADMIN_SESSION_ROLLING=0
export ADMIN_SESSION_RENEW=0
export ADMIN_SESSION_SECURE=0
export QUEUE_ADMIN_USER=queue_admin
# ================== Queues session config end =================

# ================== Application global config =================
export OPERATIONAL_BOUNDARY_LEVEL=3
export BOUNDARY_LEVEL_LABELS='National|State|LGA|Ward'
export MIN_FIXED_POST_BUFFER_M="2000"
export MAX_FIXED_POST_BUFFER_M="5000"
export TARGET_POPULATION_PERCENTAGE=0.123
export DEFAULT_LANGUAGE="en"
export SUGGESTED_LOCATION_ACCURACY_M=10
export DEV_TOOLS_PIN_CODE=1848
# ============== End Application global config =================


