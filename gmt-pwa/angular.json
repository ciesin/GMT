{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gmt-pwa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "gmt",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "concaveman",
              "core-js",
              "deep-equal",
              "density-clustering",
              "earcut",
              "exceljs",
              "file-saver",
              "geojson-equality",
              "geojson-rbush",
              "js-levenshtein",
              "jszip",
              "lodash",
              "lodash.clonedeep",
              "mapbox-to-css-font",
              "object-assign",
              "pako",
              "pbf",
              "polygon-clipping",
              "property-expr",
              "raf",
              "rbush",
              "rfdc",
              "rgbcolor",
              "semaphore-async-await",
              "skmeans",
              "turf-jsts",
              "webfont-matcher"
            ],
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "./node_modules/ngx-spinner/animations/ball-spin-clockwise.css",
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "./node_modules/ol/ol.css",
              "src/styles.less",
              "src/less/themes/material.scss",
              "src/less/themes.less",
              "src/material-overrides.less"
            ],
            "scripts": [
              "node_modules/geotiff/dist-browser/geotiff.js",
              {
                "inject": true,
                "bundleName": "hull-js",
                "input": "node_modules/hull.js/dist/hull.js"
              }
            ],
            "serviceWorker": "ngsw-config.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5mb",
                  "maximumError": "8mb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "ssl": false,
            "sslKey": "cert/localhost.key",
            "sslCert": "cert/localhost.crt"
          },
          "configurations": {
            "production": {
              "buildTarget": "gmt-pwa:build:production"
            },
            "development": {
              "buildTarget": "gmt-pwa:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "gmt-pwa:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "less",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.less"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
