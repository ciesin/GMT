{
    "version": "2.0.2",
    "compilerOptions": {
      "outDir": "./dist",
      "lib": ["es2019", "es6"],
      "target": "es2019",
      "module": "commonjs",
      "moduleResolution": "node",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "esModuleInterop": true
    },
    "include": ["./src/**/*"],
  "baseUrl": "./src",
  "paths": {
    "@api/*": ["api/*"],
    "@utils/*": ["utils/*"],
    "@config/*": ["config/*"]
  }
}
