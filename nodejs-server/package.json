{
  "name": "nodejs-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only ./src/index.ts",
    "start-queues": "ts-node-dev --trace-deprecation --respawn --transpile-only ./src/queues.ts",
    "start:prod": "tsc && NODE_ENV=production node index.js",
    "start-queues:prod": "tsc && node queues.js",
    "test": "tsc && jest --coverage=false",
    "test-ci": "tsc && jest --ci --reporters=default --reporters=jest-junit --coverage=false"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "ts",
      "tsx"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/*.{ts,js}",
      "!**/node_modules/**",
      "!**/build/**",
      "!**/coverage/**"
    ],
    "transform": {
      "\\.ts$": "<rootDir>/node_modules/ts-jest/preprocessor.js"
    },
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 30,
        "lines": 30,
        "statements": 30
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "cobertura"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(js|ts)x?$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/build/",
      "/coverage/"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/koa": "^4.12.2",
    "@keycloak/keycloak-admin-client": "^17.0.1",
    "@koa/cors": "^3.1.0",
    "@mapwhit/mbtiles": "^1.3.0",
    "@pixelygroup/keycloak-koa-connect": "^0.9.7",
    "@turf/turf": "^6.5.0",
    "axios": "^0.21.1",
    "bull": "^4.16.5",
    "cluster": "^0.7.7",
    "hull.js": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.13.1",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.3.0",
    "koa-compress": "^5.1.0",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.1",
    "koa-mount": "^4.0.0",
    "koa-passport": "^4.1.3",
    "koa-router": "^10.0.0",
    "koa-session": "^6.2.0",
    "koa-session-memory": "^1.0.4",
    "koa-static": "^5.0.0",
    "nodemailer": "^6.7.5",
    "passport": "^0.5.3",
    "passport-local": "^1.0.0",
    "pg": "^8.16.2",
    "pg-escape": "^0.2.0",
    "request-ip": "^3.3.0",
    "uuid": "^8.3.2",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@types/bull": "^3.15.9",
    "@types/jest": "^29.2.4",
    "@types/koa": "^2.13.3",
    "@types/koa-bodyparser": "^4.3.1",
    "@types/koa-json": "^2.0.18",
    "@types/koa-logger": "^3.1.1",
    "@types/koa-router": "^7.4.2",
    "@types/node": "^15.12.4",
    "@types/pg": "^8.15.1",
    "@types/request-ip": "0.0.37",
    "jest": "^29.3.1",
    "jest-junit": "^15.0.0",
    "keycloak-mock": "^1.0.10",
    "supertest": "^6.1.3",
    "ts-jest": "^29.0.3",
    "ts-node-dev": "^1.1.6",
    "typescript": "^4.3.2"
  }
}
